# Copy to .env and fill in before running: docker compose up --build

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_USER=app
DB_PASSWORD=change-me-app-password

# API
JWT_SECRET=change-me-to-a-long-random-string

# Web origin the API should accept CORS + post-login redirects from
WEB_ORIGIN=http://localhost:8080

# Okta OIDC (from your Okta admin console: Applications > your app > General)
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
OKTA_CLIENT_ID=your-client-id
OKTA_CLIENT_SECRET=your-client-secret
OKTA_REDIRECT_URI=http://localhost:3000/auth/okta/callback

# Optional — scheduled-job notifications (weekly digest, metric/commitment reminders).
# Microsoft Teams incoming webhook connector URL. Left unset = jobs just log.
TEAMS_WEBHOOK_URL=
# Email is stubbed (logged, not sent) until a real provider is wired into
# server/src/lib/notify.js — no credentials needed here yet.

# Optional — Google Analytics (GA4). Baked into the client bundle at build
# time (Vite), so changing this requires a rebuild, not just a container
# restart. Left unset = analytics code stays a no-op, nothing loads from
# Google. Get a Measurement ID from analytics.google.com > Admin > Data
# Streams > your web stream (format: G-XXXXXXXXXX).
GA_MEASUREMENT_ID=
